;
; Two moleculetypes in one file (#323) -- normal GROMACS practice, not an
; artifact of this crate's own round-trip invariant. [ molecules ] states
; 1000 copies of Water; this reader never expands that -- it is discarded,
; the same spirit as CIF core never expanding symmetry.
;

[ moleculetype ]
; name  nrexcl
Ion     1

[ atoms ]
; nr type resnr residue atom cgnr charge mass
1  Na  1  NA   NA   1   1.000000  22.990000

[ moleculetype ]
; name  nrexcl
Water   2

[ atoms ]
; nr type resnr residue atom cgnr charge mass
1  OW  1  SOL  OW   1  -0.834000  15.999400
2  HW  1  SOL  HW1  2   0.417000   1.008000
3  HW  1  SOL  HW2  3   0.417000   1.008000

[ bonds ]
1 2
1 3

[ system ]
Ion in water

[ molecules ]
; moleculetype  count
Ion     1
Water   1000
