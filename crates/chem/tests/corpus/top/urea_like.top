;
; A small urea-like fixture (#323) -- not the real urea.top, simplified to
; keep the expected counts easy to state in the unit tests.
;
#include "amber99.ff/nonexistent.itp"

[ moleculetype ]
; name  nrexcl
Urea    3

[ atoms ]
; nr type resnr residue atom cgnr charge mass
1  C   1  URE  C    1   0.880229  12.01100
2  O   1  URE  O    2  -0.613359  15.99940
3  N   1  URE  N1   3  -0.923545  14.00700
4  H   1  URE  H11  4   0.395055   1.00800
5  H   1  URE  H12  5   0.395055   1.00800

[ bonds ]
1 2
1 3
3 4

[ angles ]
; ai aj ak funct
2 1 3 1

[ dihedrals ]
; ai aj ak al funct -- proper
2 1 3 4 9

[ dihedrals ]
; ai aj ak al funct -- improper
5 1 3 4 4

[ exclusions ]
1 4 5
